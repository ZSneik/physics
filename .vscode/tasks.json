{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Scientia",
            "type": "shell",

            "linux": {
                "command": "gcc"
            },

            "windows": {
                "command": "C:\\msys64\\ucrt64\\bin\\gcc.exe"
            },

            "args": [
                "-Wall",
                "-Wextra",
                "-std=c17",
                "-I.",
                "main.c",
                "fisica/cinematica.c",
                "fisica/dinamica.c",
                "fisica/electricidad.c",
                "fisica/energia.c",
                "fisica/menufisica.c",
                "quimica/coligativas.c",
                "quimica/menuquimica.c",
                "quimica/concentraciones.c",
                "conversiones/conversiones.c",
                "-o",
                "scientia"
            ],

            "options": {
                "cwd": "${workspaceFolder}"
            },

            "problemMatcher": [
                "$gcc"
            ],

            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}