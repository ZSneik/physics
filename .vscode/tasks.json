{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Build Scientia",
            "command": "C:\\msys64\\ucrt64\\bin\\gcc.exe",
            "args": [
                "main.c",
                "fisica\\*.c",
                "quimica\\*.c",
                "conversiones\\*.c",
                "-I.",
                "-Wall",
                "-Wextra",
                "-g",
                "-o",
                "calculadora.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}